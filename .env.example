# Copy to .env (never commit it) and export before `awsco serve`:
#   set -a; source .env; set +a

# --- Slack owner confirmations (optional) ---------------------------------
# Bot token from your Slack app (OAuth & Permissions). Scopes:
#   chat:write, users:read, users:read.email, reactions:read,
#   channels:history (and im:history for DMs) to read thread replies.
AWSCO_SLACK_BOT_TOKEN=
# Channel ID (e.g. C0123ABCD) where asks are posted with the owner @-mentioned.
# Invite the bot to it: /invite @your-bot. Leave empty to DM owners instead.
AWSCO_SLACK_CHANNEL=
# Optional: map IAM user / role-session names to Slack emails or user IDs when
# they don't match, as JSON: {"deploy-bot": "U0123ABCD", "vsubbiah": "venka@acme.io"}
AWSCO_SLACK_USER_MAP=
